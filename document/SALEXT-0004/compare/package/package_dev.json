{
  "name": "salesforce-compare",
  "displayName": "Salesforce Compare",
  "description": "Compare local Salesforce DX files with the Original Org (Equal/Different status) and optionally Diff with Other Org (Local ↔ comparison Orgs). Retrieve-only.",
  "version": "1.0.0",
  "publisher": "LeftConsult",
  "icon": "images/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/left-consult/salesforce-compare"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "SCM Providers"
  ],
  "keywords": [
    "salesforce",
    "sfdx",
    "sf",
    "compare",
    "diff",
    "org",
    "metadata",
    "xml",
    "apex",
    "multi-org"
  ],
  "activationEvents": [
    "workspaceContains:**/sfdx-project.json"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "salesforce-compare",
          "title": "Salesforce Compare",
          "icon": "images/activitybar-sfc.svg"
        }
      ]
    },
    "views": {
      "salesforce-compare": [
        {
          "id": "salesforceCompare.connectedOrgs",
          "name": "Connected Orgs"
        }
      ]
    },
    "commands": [
      {
        "command": "salesforceCompare.diffWithOrg",
        "title": "Diff with Org",
        "category": "Salesforce Compare"
      },
      {
        "command": "salesforceCompare.diffWithOtherOrg",
        "title": "Diff with Other Org…",
        "category": "Salesforce Compare"
      },
      {
        "command": "salesforceCompare.recheckFile",
        "title": "Recheck Current File",
        "category": "Salesforce Compare"
      },
      {
        "command": "salesforceCompare.showLastCheck",
        "title": "Show Compare Result",
        "category": "Salesforce Compare"
      },
      {
        "command": "salesforceCompare.clearCache",
        "title": "Clear Cache",
        "category": "Salesforce Compare"
      },
      {
        "command": "salesforceCompare.disconnectComparisonOrg",
        "title": "Disconnect Org",
        "category": "Salesforce Compare",
        "icon": "$(trash)"
      },
      {
        "command": "salesforceCompare.reconnectOrg",
        "title": "Reconnect Org",
        "category": "Salesforce Compare",
        "icon": "$(key)"
      },
      {
        "command": "salesforceCompare.loginOrg",
        "title": "Authorize an Org…",
        "category": "Salesforce Compare",
        "icon": "$(key)"
      },
      {
        "command": "salesforceCompare.refreshConnectedOrgs",
        "title": "Refresh Connected Orgs",
        "category": "Salesforce Compare",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "salesforceCompare.loginOrg",
          "when": "view == salesforceCompare.connectedOrgs && salesforceCompare.hasOriginalOrg",
          "group": "navigation@1"
        },
        {
          "command": "salesforceCompare.refreshConnectedOrgs",
          "when": "view == salesforceCompare.connectedOrgs",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "salesforceCompare.reconnectOrg",
          "when": "view == salesforceCompare.connectedOrgs && viewItem =~ /salesforceCompare\\.(original|comparison)Org/",
          "group": "inline@1"
        },
        {
          "command": "salesforceCompare.disconnectComparisonOrg",
          "when": "view == salesforceCompare.connectedOrgs && viewItem =~ /salesforceCompare\\.comparisonOrg/",
          "group": "inline@2"
        },
        {
          "command": "salesforceCompare.reconnectOrg",
          "when": "view == salesforceCompare.connectedOrgs && viewItem =~ /salesforceCompare\\.(original|comparison)Org/",
          "group": "1_actions@1"
        },
        {
          "command": "salesforceCompare.disconnectComparisonOrg",
          "when": "view == salesforceCompare.connectedOrgs && viewItem =~ /salesforceCompare\\.comparisonOrg/",
          "group": "1_actions@2"
        }
      ],
      "editor/context": [
        {
          "command": "salesforceCompare.diffWithOrg",
          "when": "resourceScheme == file && salesforceCompare.isEligible",
          "group": "salesforceCompare@1"
        },
        {
          "command": "salesforceCompare.diffWithOtherOrg",
          "when": "resourceScheme == file && salesforceCompare.isEligible && salesforceCompare.hasComparisonOrgs",
          "group": "salesforceCompare@2"
        },
        {
          "command": "salesforceCompare.recheckFile",
          "when": "resourceScheme == file && salesforceCompare.isEligible",
          "group": "salesforceCompare@3"
        }
      ],
      "explorer/context": [
        {
          "command": "salesforceCompare.diffWithOrg",
          "when": "resourceScheme == file && !explorerResourceIsFolder && salesforceCompare.isEligible",
          "group": "salesforceCompare@1"
        },
        {
          "command": "salesforceCompare.diffWithOtherOrg",
          "when": "resourceScheme == file && !explorerResourceIsFolder && salesforceCompare.isEligible && salesforceCompare.hasComparisonOrgs",
          "group": "salesforceCompare@2"
        },
        {
          "command": "salesforceCompare.recheckFile",
          "when": "resourceScheme == file && !explorerResourceIsFolder && salesforceCompare.isEligible",
          "group": "salesforceCompare@3"
        }
      ],
      "commandPalette": [
        {
          "command": "salesforceCompare.diffWithOrg",
          "when": "salesforceCompare.isEligible"
        },
        {
          "command": "salesforceCompare.diffWithOtherOrg",
          "when": "salesforceCompare.isEligible && salesforceCompare.hasComparisonOrgs"
        },
        {
          "command": "salesforceCompare.recheckFile",
          "when": "salesforceCompare.isEligible"
        }
      ]
    },
    "configuration": {
      "title": "Salesforce Compare",
      "properties": {
        "salesforceCompare.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable automatic Org comparison when opening Salesforce source files."
        },
        "salesforceCompare.autoCheckOnOpen": {
          "type": "boolean",
          "default": true,
          "description": "Automatically retrieve and compare when a supported file is opened."
        },
        "salesforceCompare.targetOrg": {
          "type": "string",
          "default": "",
          "description": "Optional target org alias/username. When empty, uses Salesforce Extension Pack default or sf target-org. This is the Original Org for auto-check status."
        },
        "salesforceCompare.supportedExtensions": {
          "type": "array",
          "default": [
            ".cls",
            ".trigger",
            ".js",
            ".html",
            ".css",
            ".xml",
            ".page",
            ".component",
            ".apex",
            ".soql"
          ],
          "description": "File extensions eligible for Org comparison (still filtered by Salesforce path layout)."
        },
        "salesforceCompare.maxConcurrentCompares": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "description": "Maximum number of Org retrieve/compare jobs that run in parallel. Opening another file queues additional jobs without cancelling ones already running."
        }
      }
    },
    "colors": [
      {
        "id": "salesforceCompare.synced",
        "description": "Decoration color when local file matches the Org.",
        "defaults": {
          "dark": "#3fb950",
          "light": "#1a7f37",
          "highContrast": "#3fb950"
        }
      },
      {
        "id": "salesforceCompare.outdated",
        "description": "Decoration color when local file differs from the Org.",
        "defaults": {
          "dark": "#f85149",
          "light": "#cf222e",
          "highContrast": "#f85149"
        }
      },
      {
        "id": "salesforceCompare.checking",
        "description": "Decoration color while comparing with the Org.",
        "defaults": {
          "dark": "#8b949e",
          "light": "#6e7781",
          "highContrast": "#8b949e"
        }
      },
      {
        "id": "salesforceCompare.error",
        "description": "Decoration color when comparison failed.",
        "defaults": {
          "dark": "#d29922",
          "light": "#9a6700",
          "highContrast": "#d29922"
        }
      },
      {
        "id": "salesforceCompare.comparisonOrg",
        "description": "Tab/explorer label color for comparison-Org temp files and diffs (distinct from Original Org).",
        "defaults": {
          "dark": "#3b82f6",
          "light": "#2563eb",
          "highContrast": "#60a5fa"
        }
      },
      {
        "id": "salesforceCompare.orgAuthError",
        "description": "Connected Orgs sidebar label color when an Org has an authentication error.",
        "defaults": {
          "dark": "#f85149",
          "light": "#cf222e",
          "highContrast": "#ff7b72"
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "compile": "tsc -p ./ --noEmit",
    "package": "vsce package --no-dependencies",
    "publish:marketplace": "powershell -ExecutionPolicy Bypass -File ./scripts/publish-marketplace.ps1",
    "publish:openvsx": "powershell -ExecutionPolicy Bypass -File ./scripts/publish-openvsx.ps1",
    "publish:all": "npm run publish:marketplace && npm run publish:openvsx",
    "lint": "tsc -p ./ --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
