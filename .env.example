# Copy this file to .env and fill in the values. Never commit .env (gitignored).

# Azure DevOps Personal Access Token with scope: Marketplace -> Manage
# Create at: https://dev.azure.com/_usersSettings/tokens
VSCE_PAT=

# Publisher id on Visual Studio Marketplace / Open VSX namespace (Left Consult)
VSCE_PUBLISHER=LeftConsult

# Open VSX access token (required for Cursor marketplace)
# Create at: https://open-vsx.org/user-settings/tokens
OVSX_PAT=
